{
  "name": "shopify-mcp",
  "version": "1.0.9",
  "description": "MCP Server for Shopify API, enabling interaction with store data through GraphQL API",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.ts'",
    "clean": "rimraf dist"
  },
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "graphql",
    "ai",
    "llm",
    "claude"
  ],
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "dotenv": "^16.0.3",
    "graphql": "^16.11.0",
    "graphql-request": "^5.2.0",
    "minimist": "^1.2.8",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.2",
    "@types/node": "^18.15.11",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
